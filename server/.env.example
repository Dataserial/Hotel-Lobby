DATABASE_URL="mongodb://127.0.0.1:27018/hotel_lobby?replicaSet=rs0"
CORS_ORIGINS="http://localhost:5173"
PUBLIC_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
PORT=3000
# Optional local binding; the default is 0.0.0.0 for hosting.
# HOST=127.0.0.1
# Empty trusts no proxy; use only verified ingress IPs/CIDRs, never /0 or true.
TRUSTED_PROXY_CIDRS=
# Set false to prohibit all future bookings of physically occupied rooms.
ALLOW_FUTURE_OCCUPIED_BOOKINGS=true
# Initial admin only, on a verified empty staging database (see deploy guide).
# BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# BOOTSTRAP_ADMIN_PASSWORD=<unique password: at least 12 characters, at most 72 UTF-8 bytes>
# BOOTSTRAP_ADMIN_NAME=Administrator
# Set both values before running db:seed:demo against a separate local demo database.
# DEMO_ADMIN_EMAIL=admin@example.test
# DEMO_ADMIN_PASSWORD=<a unique password of at least 12 characters>
