generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  receptionist
  customer
}

enum RoomStatus {
  available
  occupied
  maintenance
}

enum BookingStatus {
  confirmed
  checked_in
  checked_out
  cancelled
}

enum PaymentStatus {
  pending
  paid
  refunded
}

enum PaymentMethod {
  cash
  bank_transfer
  card
}

enum PaymentTransactionKind {
  receive
  refund
}

enum ServiceUnit {
  per_night
  per_set
  per_stay
}

enum StayRequestStatus {
  new
  read
  processed
  rejected
}

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String    @unique
  passwordHash     String
  role             UserRole
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  bookingsCreated  Booking[] @relation("BookingCreatedBy")
  bookingsUpdated  Booking[] @relation("BookingUpdatedBy")
  paymentsRecorded Payment[] @relation("PaymentRecordedBy")
  transactionsRecorded PaymentTransaction[]
  sessions         Session[]
  customerGuests   Guest[] @relation("CustomerGuests")
  customerBookings Booking[] @relation("CustomerBookings")
  stayRequests     StayRequest[] @relation("StayRequestMember")
  createdById      String?   @db.ObjectId
  updatedById      String?   @db.ObjectId

  @@map("users")
}

model RoomType {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  nameKey   String   @unique
  capacity  Int
  basePrice Int
  amenities String[]
  active    Boolean  @default(true)
  supportsExtraBed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rooms     Room[]
  createdById String? @db.ObjectId
  updatedById String? @db.ObjectId

  @@map("roomTypes")
}

model AdditionalService {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  nameKey         String      @unique
  unit            ServiceUnit
  price           Int?
  included        Boolean     @default(false)
  extraBed        Boolean     @default(false)
  roomTypeIds     String[]    @db.ObjectId
  maxQuantity     Int         @default(1)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdById     String?     @db.ObjectId
  updatedById     String?     @db.ObjectId

  @@map("additionalServices")
}

model StayRequest {
  id                    String            @id @default(auto()) @map("_id") @db.ObjectId
  memberId              String            @db.ObjectId
  member                User              @relation("StayRequestMember", fields: [memberId], references: [id])
  contactName           String
  contactPhone          String
  roomTypeId            String            @db.ObjectId
  roomTypeName          String
  roomId                String?           @db.ObjectId
  roomNumber            String?
  checkInDate           String
  checkOutDate          String
  guestCount            Int
  roomPricePerNight     Int
  estimatedRoomTotal    Int
  estimatedServiceTotal Int               @default(0)
  notes                 String?
  status                StayRequestStatus @default(new)
  clientRequestId       String
  relatedBookingId      String?           @db.ObjectId
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  services              StayRequestService[]

  @@unique([memberId, clientRequestId])
  @@index([status, createdAt])
  @@index([memberId, createdAt])
  @@map("stayRequests")
}

model StayRequestService {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  requestId     String      @db.ObjectId
  request       StayRequest @relation(fields: [requestId], references: [id])
  serviceId     String      @db.ObjectId
  name          String
  quantity      Int
  unit          ServiceUnit
  price         Int?
  included      Boolean
  estimatedTotal Int        @default(0)

  @@index([requestId])
  @@map("stayRequestServices")
}

model Room {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  // Preserve the existing MongoDB "number" field and unique index.
  number     String      @unique
  floor      Int?
  roomTypeId String?     @db.ObjectId
  roomType   RoomType?   @relation(fields: [roomTypeId], references: [id])
  status     RoomStatus? @default(available)
  active     Boolean?    @default(true)
  createdAt  DateTime?   @default(now())
  updatedAt  DateTime?   @updatedAt
  bookings   Booking[]
  claims     RoomNightClaim[]
  createdById String? @db.ObjectId
  updatedById String? @db.ObjectId

  @@index([roomTypeId, status])
  @@map("Room")
}

model Guest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName      String
  phone         String
  email         String?
  documentNo    String
  documentNoKey String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bookings      Booking[]
  customerId    String? @db.ObjectId
  customer      User? @relation("CustomerGuests", fields: [customerId], references: [id])
  active        Boolean? @default(true)
  createdById   String? @db.ObjectId
  updatedById   String? @db.ObjectId

  @@index([fullName])
  @@index([phone])
  @@map("guests")
}

model Booking {
  version          Int           @default(0)
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  guestId          String        @db.ObjectId
  guest            Guest         @relation(fields: [guestId], references: [id])
  customerId       String?       @db.ObjectId
  customer         User?         @relation("CustomerBookings", fields: [customerId], references: [id])
  roomId           String        @db.ObjectId
  room             Room          @relation(fields: [roomId], references: [id])
  guestCount       Int
  checkInDate      String
  checkOutDate     String
  status           BookingStatus @default(confirmed)
  pricePerNight    Int
  totalPrice       Int
  actualCheckInAt  DateTime?
  actualCheckOutAt DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdById      String        @db.ObjectId
  createdBy        User          @relation("BookingCreatedBy", fields: [createdById], references: [id])
  updatedById      String        @db.ObjectId
  updatedBy        User          @relation("BookingUpdatedBy", fields: [updatedById], references: [id])
  payment          Payment?
  claims           RoomNightClaim[]

  @@index([roomId, checkInDate, checkOutDate])
  @@index([guestId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, checkOutDate])
  @@map("bookings")
}

model Payment {
  ledgerReady    Boolean        @default(false)
  transactions   PaymentTransaction[]
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  bookingId      String         @unique @db.ObjectId
  booking        Booking        @relation(fields: [bookingId], references: [id])
  amount         Int
  paidAmount     Int            @default(0)
  refundedAmount Int            @default(0)
  method         PaymentMethod?
  status         PaymentStatus  @default(pending)
  paidAt         DateTime?
  refundedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  recordedById   String         @db.ObjectId
  recordedBy     User           @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([status])
  @@map("payments")
}

model CustomerBookingRequest {
  key        String @id @map("_id")
  hash       String
  customerId String @db.ObjectId
  bookingId  String @db.ObjectId

  @@map("customerBookingRequests")
}

model PaymentTransaction {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  paymentId      String @db.ObjectId
  payment        Payment @relation(fields: [paymentId], references: [id])
  kind           PaymentTransactionKind
  amount         Int
  method         PaymentMethod
  reference      String
  occurredAt     DateTime
  createdAt      DateTime @default(now())
  recordedById   String @db.ObjectId
  recordedBy     User @relation(fields: [recordedById], references: [id])
  idempotencyKey String @unique
  receiptId      String? @db.ObjectId
  receipt        PaymentTransaction? @relation("ReceiptRefunds", fields: [receiptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refunds        PaymentTransaction[] @relation("ReceiptRefunds")
  reason         String?

  @@unique([kind, method, reference])
  @@index([paymentId, createdAt, id])
  @@index([receiptId])
  @@map("paymentTransactions")
}

model RoomNightClaim {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  room      Room     @relation(fields: [roomId], references: [id])
  bookingId String   @db.ObjectId
  booking   Booking  @relation(fields: [bookingId], references: [id])
  night     String
  createdAt DateTime @default(now())

  @@unique([roomId, night])
  @@index([bookingId])
  @@map("roomNightClaims")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AdminGuard {
  id      String @id @map("_id")
  version Int    @default(0)

  @@map("adminGuard")
}
