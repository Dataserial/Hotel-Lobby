#!/usr/bin/env node
// เปิด HTTP server และปิดบริการอย่างเป็นระเบียบ

/* โหลดไลบรารีและแอปที่ใช้เปิดเซิร์ฟเวอร์ */

var app = require('../app');
var debug = require('debug')('server:server');
var http = require('http');

/* อ่านพอร์ตจากค่าตั้งค่าแล้วกำหนดให้ Express */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/* สร้าง HTTP server จากแอป */

var server = http.createServer(app);

/* เปิดรับคำขอตามพอร์ตและ IP ที่กำหนด */

server.listen(port, process.env.HOST || '0.0.0.0');
server.on('error', onError);
server.on('listening', onListening);

let shuttingDown = false;
// หยุดรับคำขอและปิดฐานข้อมูลให้เรียบร้อย
async function shutdown() {
  if (shuttingDown) return;
  shuttingDown = true;
  app.locals.draining = true;
  const deadline = setTimeout(() => process.exit(1), 10000);
  deadline.unref();
  server.close(async () => {
    try { await require('../lib/prisma').$disconnect(); process.exitCode = 0; }
    catch { process.exitCode = 1; }
    finally { clearTimeout(deadline); }
  });
  server.closeIdleConnections?.();
}
process.on('SIGTERM', shutdown);
process.on('SIGINT', shutdown);

/* แปลงพอร์ตเป็นตัวเลข ชื่อ pipe หรือค่าที่ใช้ไม่ได้ */

// แปลงค่าพอร์ตให้เป็นรูปแบบที่เซิร์ฟเวอร์รองรับ
function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // ใช้ชื่อ pipe แทนพอร์ตตัวเลข
    return val;
  }

  if (port >= 0) {
    // ใช้พอร์ตที่เป็นตัวเลข
    return port;
  }

  return false;
}

/* รับเหตุการณ์เมื่อเปิดเซิร์ฟเวอร์ผิดพลาด */

// แสดงสาเหตุเมื่อเปิดเซิร์ฟเวอร์ไม่สำเร็จ
function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // แสดงสาเหตุที่อ่านง่ายเมื่อเปิดพอร์ตไม่ได้
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/* แจ้งเมื่อเซิร์ฟเวอร์เปิดรับคำขอแล้ว */

// แจ้งพอร์ตเมื่อเซิร์ฟเวอร์พร้อมรับคำขอ
function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
  console.log('Backend listening on ' + bind + '; readiness: http://localhost:' + port + '/ready');
}
