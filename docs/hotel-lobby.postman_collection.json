{
  "info": {
    "name": "Hotel-Lobby backend demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run on a disposable local demo database only. Set email/password locally. Receipt is synthetic demo evidence, never a real payment. Includes Task 1–5 happy flow and public/auth error checks."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "roomTypeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "roomId",
      "value": "",
      "type": "string"
    },
    {
      "key": "guestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "checkInDate",
      "value": "",
      "type": "string"
    },
    {
      "key": "checkOutDate",
      "value": "",
      "type": "string"
    },
    {
      "key": "occurredAt",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Login') {",
          "  pm.collectionVariables.set('runId', String(Date.now()));",
          "  const parts = new Intl.DateTimeFormat('en-US', {timeZone:'Asia/Bangkok',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());",
          "  const get = t => parts.find(p => p.type === t).value;",
          "  const today = `${get('year')}-${get('month')}-${get('day')}`;",
          "  const tomorrow = new Date(today+'T00:00:00Z'); tomorrow.setUTCDate(tomorrow.getUTCDate()+1);",
          "  pm.collectionVariables.set('checkInDate', today); pm.collectionVariables.set('checkOutDate', tomorrow.toISOString().slice(0,10));",
          "}",
          "pm.collectionVariables.set('occurredAt', new Date().toISOString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create room type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/room-types",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Demo {{runId}}\",\"capacity\":2,\"basePrice\":1500}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('roomTypeId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create room",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/rooms",
        "body": {
          "mode": "raw",
          "raw": "{\"roomNumber\":\"D{{runId}}\",\"floor\":1,\"roomTypeId\":\"{{roomTypeId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('roomId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create guest",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/guests",
        "body": {
          "mode": "raw",
          "raw": "{\"fullName\":\"Demo Guest\",\"phone\":\"0812345678\",\"documentNo\":\"DEMO{{runId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('guestId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff availability",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/rooms/availability?checkInDate={{checkInDate}}&checkOutDate={{checkOutDate}}&guestCount=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\"roomId\":\"{{roomId}}\",\"guestId\":\"{{guestId}}\",\"guestCount\":2,\"checkInDate\":\"{{checkInDate}}\",\"checkOutDate\":\"{{checkOutDate}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('bookingId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Record demo receipt",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "demo-{{runId}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/payment/receipts",
        "body": {
          "mode": "raw",
          "raw": "{\"amount\":1500,\"method\":\"cash\",\"reference\":\"DEMO-{{runId}}\",\"occurredAt\":\"{{occurredAt}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Check in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/check-in",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
