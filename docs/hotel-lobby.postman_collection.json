    },
    {
      "name": "Public availability",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/rooms/availability?checkInDate={{checkInDate}}&checkOutDate={{checkOutDate}}&guestCount=2"
      },
      "event": [
        {
          "listen": "test",
